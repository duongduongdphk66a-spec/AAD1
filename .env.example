# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g. https://example.run.app).
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and CSP frame-ancestors.
APP_URL=""

# VITE_TERRAIN_V3: Enables the 10-level Geometry Clipmap + Sparse Tile Pyramid + SDF Stamp & Link v3 engine ("true" or "false").
VITE_TERRAIN_V3="true"

# API_AUTH_TOKEN: Optional token for server-to-server / API callers via Authorization: Bearer or x-api-key.
# Leave empty or placeholder when the browser SPA calls /api/reconstruct directly (an SPA cannot hold a secret).
# Set REQUIRE_API_AUTH="true" ONLY if an upstream proxy / gateway injects the token on every request.
API_AUTH_TOKEN=""
REQUIRE_API_AUTH="false"

# GEMINI_MODEL: Optional override for the Gemini vision model used by /api/reconstruct.
GEMINI_MODEL="gemini-3-flash-preview"

# AI quota & budget controls (failed or rejected Gemini calls are automatically refunded):
AI_MAX_CALLS_PER_HOUR="200"
AI_MAX_CALLS_PER_IP_HOUR="30"
GEMINI_DAILY_BUDGET="500"

# Reverse proxy & CSP framing configuration for self-hosted deployments:
# Set TRUST_PROXY_HOPS="1" only when running behind a trusted reverse proxy (e.g., Cloud Run, Nginx, Cloudflare).
TRUST_PROXY_HOPS="0"
# Space-separated frame-ancestors allowed to embed the studio in an iframe:
CSP_FRAME_ANCESTORS="'self' https://aistudio.google.com https://*.googleusercontent.com"

